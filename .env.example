# Public browser configuration. Replace these placeholders with your project values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# URL of the separately deployed API used by the frontend API client and chatbot.
NEXT_PUBLIC_API_URL=https://your-api.example.com
# Optional chatbot-specific API override; defaults to NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_BASE_URL=https://your-api.example.com
